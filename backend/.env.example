NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ledgerly

# JWT secrets - use strong random values in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS allow-list (comma separated origins)
CORS_ORIGINS=http://localhost:5173

# Mail transport: console (dev) or smtp
MAIL_TRANSPORT=console
MAIL_FROM=Ledgerly <no-reply@ledgerly.dev>

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Seeding
# Set to 'false' to skip demo data
SEED_DEMO_DATA=true
SEED_ADMIN_PASSWORD=Admin123!